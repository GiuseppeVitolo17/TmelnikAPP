rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Helper: check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ============================================================
    // COLLECTION: users
    // ============================================================
    match /users/{userId} {
      // Read: users can read their own profile, admins can read all
      allow read: if isAuthenticated() && 
                     (request.auth.uid == userId || isAdmin());
      
      // Write: only the owner can update their profile
      // Only admins can change the isAdmin field
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      allow update: if isAuthenticated() && (
        // A user can change only specific fields of their profile
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']))
        ||
        // Admins may update any field
        isAdmin()
      );
      
      allow delete: if isAdmin() && request.auth.uid != userId;
    }
    
    // ============================================================
    // COLLECTION: project_offers
    // ============================================================
    match /project_offers/{offerId} {
      // Read: any authenticated user can read active offers
      allow read: if isAuthenticated() && 
                     (!resource.data.isActive || isAdmin());
      
      // Create: admins only
      allow create: if isAdmin();
      
      // Update: admins only
      allow update: if isAdmin();
      
      // Delete: admins only (soft delete by setting isActive = false)
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // COLLECTION: journal_entries (personal diaries)
    // ============================================================
    match /journal_entries/{entryId} {
      // Only the owner can read/write their own diary
      allow read, write: if isAuthenticated() && 
                           resource.data.userId == request.auth.uid;
    }
    
    // ============================================================
    // COLLECTION: feedback
    // ============================================================
    match /feedback/{feedbackId} {
      // Read: any authenticated user can view feedback items
      allow read: if isAuthenticated();
      
      // Create: any authenticated user can create feedback
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Update: owner or admins only
      allow update: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
      
      // Delete: owner or admins only
      allow delete: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // ============================================================
    // COLLECTION: news
    // ============================================================
    match /news/{newsId} {
      // Read: any authenticated user can view active news
      allow read: if isAuthenticated() && 
                     (!resource.data.isActive || isAdmin());
      
      // Write: admins only
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================================
    // COLLECTION: info_items (general information)
    // ============================================================
    match /info_items/{itemId} {
      // Read: public to any authenticated user
      allow read: if isAuthenticated();
      
      // Write: admins only
      allow create, update, delete: if isAdmin();
    }
  }
}
