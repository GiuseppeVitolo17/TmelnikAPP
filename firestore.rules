rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Helper function to check if user is organizer
    function isOrganizer() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOrganizer == true;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if isOwner(userId);
      // Admins can read all users
      allow read: if isAdmin();
      // Users can create/update their own document (for initialization)
      allow create: if isOwner(userId);
      // Only admins can update user roles
      allow update: if isAdmin() || 
                     (isOwner(userId) && 
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isOrganizer', 'ngoId']));
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Project Offers collection
    match /project_offers/{offerId} {
      // All authenticated users can read active offers
      allow read: if isAuthenticated();
      // Only admins can create/update/delete offers
      allow create, update, delete: if isAdmin();
    }
    
    // NGOs collection
    match /ngos/{ngoId} {
      // All authenticated users can read active NGOs
      allow read: if isAuthenticated() && (resource.data.isActive == true || !exists(resource.data.isActive));
      // Only admins can create/update/delete NGOs
      allow create, update, delete: if isAdmin();
    }
    
    // Feedback collection
    match /feedback/{feedbackId} {
      // Users can read active feedback
      allow read: if isAuthenticated() && (resource.data.isActive == true || !exists(resource.data.isActive));
      // Users can create their own feedback
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Users can update their own feedback, admins can update any
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      // Only admins can delete feedback
      allow delete: if isAdmin();
    }
    
    // News collection
    match /news/{newsId} {
      // All authenticated users can read active news
      allow read: if isAuthenticated() && (resource.data.isActive == true || !exists(resource.data.isActive));
      // Only admins can create/update/delete news
      allow create, update, delete: if isAdmin();
    }
    
    // Info Items collection
    match /info_items/{itemId} {
      // All authenticated users can read active info items
      allow read: if isAuthenticated() && (resource.data.isActive == true || !exists(resource.data.isActive));
      // Only admins can create/update/delete info items
      allow create, update, delete: if isAdmin();
    }
    
    // Daily Reflections collection
    match /daily_reflections/{reflectionId} {
      // Users can read their own reflections
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      // Organizers can read reflections from their NGO users
      allow read: if isOrganizer() && 
                     resource.data.userId != null &&
                     get(/databases/$(database)/documents/users/$(resource.data.userId)).data.ngoId == 
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ngoId;
      // Admins can read all reflections
      allow read: if isAdmin();
      // Users can create their own reflections
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Users can update their own reflections
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      // Users can delete their own reflections, admins can delete any
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    // Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
